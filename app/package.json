{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:zones": "tsc -p tsconfig.tests.json && node ./.tests-dist/tests/blankZones.test.js",
    "test": "tsc -p tsconfig.tests.json && node -e \"require('fs').readdirSync('./.tests-dist/tests').filter(f=>f.endsWith('.test.js')).sort().forEach(f=>require('./.tests-dist/tests/'+f))\"",
    "format": "prettier --write \"src/**/*.{ts,vue}\"",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist -b main -t true"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-highlightjs": "^4.3.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.7.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14",
    "eslint": "^9",
    "eslint-plugin-vue": "^9",
    "gh-pages": "^6.2.0",
    "globals": "^17.7.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8",
    "vite": "^6.1.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-wasm": "^3.4.0",
    "vue-tsc": "^2.2.4"
  }
}
